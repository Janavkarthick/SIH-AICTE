# Database connection (SQLite default or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./aicte_verify.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicte_verify

# JWT Authentication
JWT_SECRET_KEY=aicte-verify-development-super-secret-jwt-key-2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# File Uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# AI & LLM integration (Optional)
GEMINI_API_KEY=

# Security & Rate Limiting
RATE_LIMIT_AUTH=10/minute
DATA_RETENTION_DAYS=365
DEBUG=True

# Service URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CONFIG_RULES_DIR=./config/rules
