# AICTE-Verify Environment Configuration
# Copy to .env and adjust values

# Database (SQLite by default, set to postgres URL for production)
DATABASE_URL=sqlite:///./aicte_verify.db
# DATABASE_URL=postgresql://user:password@postgres:5432/aicte_verify

# JWT Secret (change in production!)
JWT_SECRET_KEY=dev-secret-key-change-in-production-abc123
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Upload settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# Optional: Gemini API for letter improvement (app works fully without it)
# GEMINI_API_KEY=

# Rate limiting
RATE_LIMIT_AUTH=10/minute

# Data retention days
DATA_RETENTION_DAYS=365

# Debug mode (set to false in production)
DEBUG=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000
